# =====================================================
# LOGIN PAGE
# =====================================================
def login_page():
    inject_css()
    _, center, _ = st.columns([1, 1.5, 1])

    with center:
        st.markdown('<div class="smurf-card">', unsafe_allow_html=True)
        st.markdown('<div class="smurf-badge">Restricted Access</div>', unsafe_allow_html=True)
        st.title("🛡️ SMURF")
        st.subheader("Cybercrime Investigation Intelligence System")
        st.caption("Authorized personnel only. All access attempts are cryptographically logged.")
        st.divider()

        now = time.time()
        locked_out = now < st.session_state.get("lockout_until", 0.0)

        if locked_out:
            remaining = int(st.session_state["lockout_until"] - now)
            st.error(f"⛔ Account temporarily locked. Try again in {remaining} seconds.")
            st.progress((LOCKOUT_SECONDS - remaining) / LOCKOUT_SECONDS)
        else:
            with st.form("login_form", clear_on_submit=False):
                username = st.text_input("Officer ID", placeholder="e.g., admin")
                password = st.text_input("Password", type="password", placeholder="••••••••")
                submitted = st.form_submit_button("🔑 Secure Login", use_container_width=True)

            if submitted:
                if not username or not password:
                    st.warning("Please enter both Officer ID and Password.")
                elif check_password(username, password):
                    st.session_state["authenticated"] = True
                    st.session_state["username"] = username
                    st.session_state["login_attempts"] = 0
                    st.session_state["last_login"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                    st.rerun()
                else:
                    st.session_state["login_attempts"] += 1
                    remaining_tries = MAX_LOGIN_ATTEMPTS - st.session_state["login_attempts"]
                    
                    if remaining_tries <= 0:
                        st.session_state["lockout_until"] = now + LOCKOUT_SECONDS
                        st.session_state["login_attempts"] = 0
                        st.error("⛔ Maximum attempts reached. Account locked for 60 seconds.")
                        st.rerun()
                    else:
                        st.error(f"Invalid credentials. {remaining_tries} attempt(s) remaining.")
        st.markdown('</div>', unsafe_allow_html=True)


