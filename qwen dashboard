# =====================================================
# AUTHENTICATION & SECURITY
# =====================================================
def _make_demo_user(password: str, salt: bytes | None = None) -> dict:
    """Create a {salt, hash} record using PBKDF2-HMAC-SHA256."""
    salt = salt or os.urandom(16)
    pwd_hash = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 200_000)
    return {"salt": salt, "hash": pwd_hash}

# Demo credentials (Replace with DB lookup in production)
USERS = {
    "admin": _make_demo_user("SMURF@123", salt=b"static-demo-salt-1"),
    "officer": _make_demo_user("Police@123", salt=b"static-demo-salt-2"),
}

def check_password(username: str, password: str) -> bool:
    """Constant-time password verification."""
    record = USERS.get(username)
    if record is None:
        # Decoy hash to prevent timing attacks revealing valid usernames
        hashlib.pbkdf2_hmac("sha256", password.encode(), b"decoy-salt", 200_000)
        return False
    candidate = hashlib.pbkdf2_hmac("sha256", password.encode(), record["salt"], 200_000)
    return hmac.compare_digest(candidate, record["hash"])

# =====================================================
# SESSION STATE MANAGEMENT
# =====================================================
def init_session_state():
    defaults = {
        "authenticated": False,
        "username": None,
        "login_attempts": 0,
        "lockout_until": 0.0,
        "active_module": "overview",
        "last_login": None,
    }
    for key, value in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = value

def logout():
    """Cleanly tear down authentication state."""
    auth_keys = ["authenticated", "username", "login_attempts", "lockout_until", "last_login"]
    for key in auth_keys:
        if key in st.session_state:
            del st.session_state[key]
    st.session_state["active_module"] = "overview"
    st.rerun()

